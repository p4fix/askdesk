# ==============================================================
# AskDesk Production Environment Configuration Template
# Copy to .env in production deployment environments
# ==============================================================

# Application Security
DEBUG=False
SECRET_KEY=generate-a-strong-random-50-char-secret-key-here
ALLOWED_HOSTS=yourdomain.com,api.yourdomain.com,backend,frontend,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://yourdomain.com,http://localhost

# PostgreSQL with pgvector Database
DB_NAME=askdesk_db
DB_USER=askdesk_admin
DB_PASSWORD=choose-a-strong-database-password-here
DB_HOST=db
DB_PORT=5432
USE_SQLITE=False

# JWT Session Lifetimes
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=14

# AI Model Integrations (Optional in mock mode; required for OpenAI)
OPENAI_API_KEY=sk-proj-...
EMBEDDING_SERVICE=openai
LLM_SERVICE=openai
