SECRET_KEY=django-insecure-askdesk-dev-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend

# Database (PostgreSQL with pgvector)
# Set USE_SQLITE=True if testing locally without PostgreSQL running
USE_SQLITE=False
DB_NAME=askdesk_db
DB_USER=askdesk_user
DB_PASSWORD=askdesk_password
DB_HOST=localhost
DB_PORT=5432

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT Configuration
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

